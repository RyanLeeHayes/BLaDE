C1E   X     X     P1T    55.00    0     35.3   ! thr
C1E   X     X     A3K    55.00    0     35.3   ! lys
C1E   X     X     A3R    55.00    0     35.3   ! arg
C1E   X     X     A4H    55.00    0     35.3   ! his
C1E   X     X     A1F    55.00    0     35.3   ! phe
C1E   X     X     A1Y    55.00    0     35.3   ! tyr
C1E   X     X     A1W    55.00    0     35.3   ! trp
C1E   X     X     A2P    55.00    0     35.3   ! pro

!## for pSer                                         
C1E   X     X     P2S    55.00    0     35.3   ! pSer
!## for pThr                                         
C1E   X     X     P2T    55.00    0     35.3   ! pThr
!CD-CE-CF-CB CD-CE-CF-CC improper in trp
A2W   A3W   A4W   A1W    47.78    0     0.0    ! trp
A2W   A3W   A4W   P1W    47.78    0     0.0    ! trp

!# for Proline peptide bond

variables set temp 298
variables set nsteps 10000
parameters file comp/param_hyres_mix.inp
structure file psf demo.psf
coordinates file crd minimized.crd
msld nblocks 0
coordinates box cubi 150 150 150 90 90 90
coordinates velocity 298
run setvariable debyelength 7.842  
run setvariable dielectric 60.53
run setvariable rcut 18
run setvariable rswitch 16
run setvariable rswitchhyres 11
run setvariable rcuthyres 12
run setvariable vdwmethod hyres
run setvariable elecmethod debye
run setvariable hbond on
run setvariable hbondlist domdec
run setvariable fnmxtc pep_flat.xtc
run setvariable fnmnrg pep_flat.nrg
run setvariable fnmcpo pep_flat.res
run setvariable nsteps {nsteps}
run setvariable dt 0.0001
run setvariable T {temp}
run setvariable gamma 0.1
run setvariable freqxtc 10000
run setvariable freqnrg 10000
run setvariable freqnpt 0
run dynamics
run setvariable nsteps 100000
run setvariable dt 0.008
run setvariable fnmxtc pep_prod.xtc
run setvariable fnmnrg pep_prod.nrg
run setvariable fnmcpo pep_prod.res
run dynamics

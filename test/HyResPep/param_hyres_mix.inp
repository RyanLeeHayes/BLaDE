* HyRes force field for hyres_iConRNA
* mass of backbone atoms and H was increased to 25
* strength of bonds and angles was halfed
* parameter file for coarse grained proteins with heavy backbones
* 

BOND
!
!V(bond) = Kb(b - b0)**2
!
!Kb: kcal/mole/A**2
!b0: A
!
!atom type   Kb         b0
!

!bonds in amino acid backbone
H     NH1    300.0      0.98  ! H-N (non-pro)               
C1E   NH1    320.0      1.45  ! CA-N (non-pro, non-gly)     
C2E   NH1    320.0      1.45  ! CA-N (gly)                  
C1E   N      320.0      1.45  ! CA-N (pro)                  
C     C1E    250.0      1.52  ! C-CA (non-gly)              
C     C2E    250.0      1.52  ! C-CA (gly)                  
C     O      380.0      1.23  ! C=O                         
C     NH1    370.0      1.33  ! C-N (non-pro)               
C     N      260.0      1.33  ! C-N (pro)                   
C     C3E    250.0      1.52  ! C-CH3 in N-ter capping group
C3E   NH1    320.0      1.49  ! N-CH3 in C-ter capping group
!bonds in amino acid backbone-sidechain
C1E   C3E    300.0      1.63  ! ala
C1E   A2V    300.0      2.01  ! val
C1E   A1L    200.0      2.71  ! leu
C1E   A1I    100.0      2.33  ! ile
C1E   A5M    100.0      3.26  ! met
C1E   P5N    200.0      2.56  ! asn
C1E   QAD    200.0      2.54  ! asp
C1E   P4Q    300.0      3.45  ! gln
C1E   QAE    100.0      3.14  ! glu
C1E   P1C    300.0      2.40  ! cys
C1E   P1S    300.0      2.03  ! ser
C1E   P1T    300.0      2.01  ! thr
C1E   A3K    200.0      2.65  ! lys
C1E   A3R    200.0      2.65  ! arg
C1E   A4H    400.0      1.95  ! his
C1E   A1F    150.0      2.30  ! phe
C1E   A1Y    150.0      2.30  ! tyr
C1E   A1W    300.0      1.99  ! trp
C1E   A2P    300.0      1.92  ! pro
!## CA-CB bonds for pSer and pThr   
C1E   P2S    250.0      1.61  ! pSer
C1E   P2T    200.0      2.03  ! pThr
!bonds in amino acid sidechain-sidechain
A3K   QDK    100.0      2.95  ! lys
A3R   QDR    100.0      3.60  ! arg
A4H   P1H    200.0      2.52  ! his CB-CC
A4H   P2H    300.0      2.45  ! his CB-CD
P1H   P2H    300.0      1.86  ! his CC-CD
A1F   A2F    300.0      2.45  ! phe CB-CC
A1F   A3F    300.0      2.87  ! phe CB-CD
A2F   A3F    300.0      2.22  ! phe CC-CD
A1Y   A2Y    300.0      2.45  ! tyr CB-CC
A1Y   P1Y    300.0      3.52  ! tyr CB-CD
A2Y   P1Y    300.0      2.44  ! tyr CC-CD
A1W   P1W    300.0      2.58  ! trp CB-CC
A1W   A2W    300.0      2.53  ! trp CB-CD
P1W   A2W    300.0      1.85  ! trp CC-CD
A2W   A3W    300.0      2.15  ! trp CD-CE
A2W   A4W    300.0      2.15  ! trp CD-CF
A3W   A4W    300.0      2.25  ! trp CE-CF
!## CB-CC bonds for pSer and pThr           
P2S   P3S    200.0      2.53  ! pSer CB-CC  
P2T   P3T    200.0      3.20  ! pThr CB-CC  
! special bond in pro
N     A2P    400.0      1.86  ! pro
! For PEG
PEG   PEG     10.0      3.60  ! PEG-PEG, use the distance between two EO units (O-O) as b0


ANGLES
!V = V(angle) + V(Urey-Bradley)
!
!V(angle) = Ktheta(Theta - Theta0)**2
!
!V(Urey-Bradley) = Kub(S - S0)**2
!
!Ktheta: kcal/mole/rad**2
!Theta0: degrees
!Kub: kcal/mole/A**2 (Urey-Bradley)
!S0: A
!
!atom types     Ktheta    Theta0   Kub     S0
!

!angles in amino acid backbone
C     NH1   H     30.0     120.0  ! H-N-C                       
C1E   NH1   H     35.0     120.0  ! H-N-CA (non-gly)            
C2E   NH1   H     35.0     120.0  ! H-N-CA (gly)                
C     NH1   C1E   77.5     120.0  ! C-N-CA (non-pro, non-gly)   
C     NH1   C2E   77.5     120.0  ! C-N-CA (ala-gly)            
C     N     C1E   80.0     120.0  ! C-N-CA (ala-pro)            
C     C1E   NH1   45.0     111.6  ! N-CA-C (non-pro, non-gly)    
C     C1E   N     45.0     111.6  ! N-CA-C (pro)                 
C     C2E   NH1   70.0     111.6  ! N-CA-C (gly)                
C1E   C     NH1   20.0     117.5  ! CA-C-N (non-pro, non-gly)   
C1E   C     N     20.0     117.5  ! CA-C-N (ala-pro)            
C2E   C     N     20.0     117.5  ! CA-C-N (gly-pro)             
C2E   C     NH1   20.0     117.5  ! CA-C-N (gly-ala)            
C1E   C     O     85.0     121.5  ! CA-C-O (non-gly)            
C2E   C     O     85.0     121.6  ! CA-C-O (gly)                
NH1   C     O     65.0     121.0  ! O-C-N (non-pro)             
N     C     O     85.0     121.0  ! O-C-N (pro)                 
C3E   C     O     85.0     121.5  ! CH3-C-O (N-ter)             
C3E   C     NH1   20.0     117.5  ! CH3-C-N (N-ter of non-pro)  
C3E   C     N     20.0     117.5  ! CH3-C-N (N-ter of pro)      
C3E   NH1   H     35.0     120.0  ! H-N-CH3 (C-ter)             
C     NH1   C3E   77.5     120.0  ! C-N-CH3 (C-ter)             
!C-CA-CB angle in amino acid
C     C1E   C3E   90.0     111.2  ! ala
C     C1E   A2V   20.0     116.3  ! val
C     C1E   A1L   20.0     120.6  ! leu  
C     C1E   A1I   20.0     117.8  ! ile  
C     C1E   A5M   20.0     119.8  ! met  
C     C1E   P5N   20.0     127.0  ! asn  
C     C1E   QAD   20.0     121.1  ! asp  
C     C1E   P4Q   20.0     119.1  ! gln  
C     C1E   QAE   20.0     116.2  ! glu  
C     C1E   P1C   20.0     118.3  ! cys  
C     C1E   P1S   20.0     109.4  ! ser  
C     C1E   P1T   20.0     116.2  ! thr  
C     C1E   A3K   20.0     117.0  ! lys  
C     C1E   A3R   20.0     118.5  ! arg  
C     C1E   A4H   20.0     112.5  ! his  
C     C1E   A1F   20.0     123.2  ! phe  
C     C1E   A1Y   20.0     123.6  ! tyr  
C     C1E   A1W   20.0     116.0  ! trp  
C     C1E   A2P   20.0     115.0  ! pro   change from 121.7 to 115
!## bond of C-CA-CB for pSer and pThr    
C     C1E   P2S   20.0     112.3  ! pSer 
C     C1E   P2T   20.0     101.2  ! pThr 

!N-CA-CB angle in amino acid
C3E   C1E   NH1   90.0     109.5  ! ala
A2V   C1E   NH1   20.0     111.3  ! val 
A1L   C1E   NH1   20.0     114.3  ! leu 
A1I   C1E   NH1   20.0     110.4  ! ile 
A5M   C1E   NH1   20.0     112.7  ! met 
P5N   C1E   NH1   20.0     104.6  ! asn 
QAD   C1E   NH1   20.0     106.4  ! asp 
P4Q   C1E   NH1   20.0     111.0  ! gln 
QAE   C1E   NH1   20.0     113.7  ! glu 
P1C   C1E   NH1   20.0     107.0  ! cys 
P1S   C1E   NH1   20.0     114.2  ! ser 
P1T   C1E   NH1   20.0     106.9  ! thr 
A3K   C1E   NH1   20.0     112.3  ! lys 
A3R   C1E   NH1   20.0     112.2  ! arg 
A4H   C1E   NH1   20.0     112.8  ! his 
A1F   C1E   NH1   20.0     108.2  ! phe 
A1Y   C1E   NH1   20.0     108.7  ! tyr 
A1W   C1E   NH1   20.0     110.8  ! trp 
!## for pSer and pThr                     
P2S   C1E   NH1   20.0     110.3  ! pSer  
P2T   C1E   NH1   20.0      98.4  ! pThr  
!CA-CB-CC (and/or CA-CB-CD) angle in amino acid
C1E   A3K   QDK   20.0     144.9  ! lys
C1E   A3R   QDR   20.0     137.9  ! arg
C1E   A4H   P1H   20.0     129.5  ! his CA-CB-CC
C1E   A4H   P2H   20.0     127.6  ! his CA-CB-CD
C1E   A1F   A2F   10.0     116.0  ! phe CA-CB-CC
C1E   A1F   A3F   20.0     140.2  ! phe CA-CB-CD
C1E   A1Y   A2Y   10.0     115.8  ! tyr CA-CB-CC
C1E   A1Y   P1Y   20.0     139.2  ! tyr CA-CB-CD
C1E   A1W   P1W   20.0     125.6  ! trp CA-CB-CC
C1E   A1W   A2W   20.0     133.7  ! trp CA-CB-CD
!## for pSer and pThr                                   
C1E   P2S   P3S   20.0     132.8  ! pSer CA-CB-CC (PO4) 
C1E   P2T   P3T   20.0      72.6  ! pThr CA-CB-CC (PO4) 
!CC-CD-CE, CC-CD-CF, CB-CD-CE, CB-CD-CF in trp
!#A1W   A2W   A3W   50.0     161.0  ! trp
P1W   A2W   A3W   50.0     127.9  ! trp
A1W   A2W   A4W   50.0     98.6   ! trp
!#P1W   A2W   A4W   50.0     168.1  ! trp
!C-N-CB for pro
C     N     A2P   0.00     161.9  ! pro
!angles within the ring of amino acid side chain
P1H   A4H   P2H   0.00     60.0   ! his
A4H   P2H   P1H   0.00     60.0   ! his
P2H   P1H   A4H   0.00     60.0   ! his
A1F   A2F   A3F   0.00     60.0   ! phe
A2F   A3F   A1F   0.00     60.0   ! phe
A3F   A1F   A2F   0.00     60.0   ! phe
A1Y   A2Y   P1Y   0.00     60.0   ! tyr
A2Y   P1Y   A1Y   0.00     60.0   ! tyr
P1Y   A1Y   A2Y   0.00     60.0   ! tyr
A1W   P1W   A2W   0.00     60.0   ! trp
A1W   A2W   P1W   0.00     60.0   ! trp
A2W   A1W   P1W   0.00     60.0   ! trp
A2W   A3W   A4W   0.00     60.0   ! trp
A2W   A4W   A3W   0.00     60.0   ! trp
A3W   A2W   A4W   0.00     60.0   ! trp
N     C1E   A2P   0.00     60.0   ! pro
N     A2P   C1E   0.00     60.0   ! pro
C1E   N     A2P   0.00     60.0   ! pro
! For PEG
PEG   PEG   PEG   10.0    123.0   ! PEG-PEG-PEG


DIHEDRALS
!
!V(dihedral) = Kchi(1 + cos(n(chi) - delta))
!
!Kchi: kcal/mole
!n: multiplicity
!delta: degrees
!
!atom types             Kchi    n   delta
!

!phi in amino acid backbone
C     C1E   N     C       0.30    3     0.0    ! phi (pro)
X     C1E   N     X       0.00    3     0.0    ! not phi (pro)
C     C1E   NH1   C       0.30    3     0.0    ! phi (ala)
X     C1E   NH1   X       0.00    3     0.0    ! not phi (ala)
C     C2E   NH1   C       0.30    3     0.0    ! phi (gly)
X     C2E   NH1   X       0.00    3     0.0    ! not phi (gly)
!psi in amino acid backbone
O     C     C1E   QAD     0.30    1     240.0  ! pseudo psi (glu)
O     C     C1E   P5N     0.30    1     240.0  ! pseudo psi (asn)
O     C     C1E   P1T     0.30    1     240.0  ! pseudo psi (thr)
O     C     C1E   P1C     0.30    1     240.0  ! pseudo psi (cys)
O     C     C1E   A2V     0.30    1     240.0  ! pseudo psi (val)
X     C     C1E   X       0.00    3     0.0    ! psi (non-gly)
X     C     C2E   X       0.00    3     0.0    ! psi (gly)
!omega in amino acid backbone
C3E   C     N     C1E     2.75    2     180.0  ! AMN-PRO
C1E   C     N     C1E     2.75    2     180.0  ! ALA-PRO
C2E   C     N     C1E     2.75    2     180.0  ! GLY-PRO
X     C     N     X       0.00    2     180.0  ! other (pro)
C3E   C     NH1   C1E     9.00    2     180.0  ! AMN-ALA
C1E   C     NH1   C1E     9.00    2     180.0  ! ALA-ALA
C2E   C     NH1   C1E     9.00    2     180.0  ! GLY-ALA
C1E   C     NH1   C3E     9.00    2     180.0  ! ALA-CBX
C3E   C     NH1   C2E     9.00    2     180.0  ! AMN-GLY 
C1E   C     NH1   C2E     9.00    2     180.0  ! ALA-GLY 
C2E   C     NH1   C2E     9.00    2     180.0  ! GLY-GLY 
C2E   C     NH1   C3E     9.00    2     180.0  ! GLY-CBX
X     C     NH1   X       0.00    2     180.0  ! other (ala)
!chi(N-CA-CB-CC) in lys, arg, his, phe, tyr, and trp
NH1   C1E   A3K   QDK     0.30    3     0.0    ! lys
NH1   C1E   A3K   QDK     0.50    1     75.0   ! lys
NH1   C1E   A3R   QDR     0.30    3     0.0    ! arg
NH1   C1E   A3R   QDR     0.50    1     75.0   ! arg
NH1   C1E   A4H   P1H     0.60    3     0.0    ! his
NH1   C1E   A4H   P1H     0.40    1     75.0   ! his
!NH1   C1E   A4H   P1H     0.10    1     50.0   ! his
NH1   C1E   A1F   A2F     0.80    3     180.0  ! phe
NH1   C1E   A1F   A2F     0.30    1     100.0  ! phe
!NH1   C1E   A1F   A2F     0.10    1     50.0   ! phe
NH1   C1E   A1Y   A2Y     0.90    3     180.0  ! tyr
NH1   C1E   A1Y   A2Y     0.30    1     90.0   ! tyr
!NH1   C1E   A1Y   A2Y     0.10    1     50.0   ! tyr
NH1   C1E   A1W   P1W     0.80    3     0.0    ! trp
NH1   C1E   A1W   P1W     0.80    1     85.0   ! trp
!## for pSer                                         
NH1   C1E   P2S   P3S     0.30    3     0.0    ! pSer
NH1   C1E   P2S   P3S     0.50    1     75.0   ! pSer
!## for pThr                                         
NH1   C1E   P2T   P3T     0.30    3     0.0    ! pThr
NH1   C1E   P2T   P3T     0.50    1     75.0   ! pThr

!N-CA-CB-CD
NH1   C1E   A4H   P2H     0.00    2     180.0  ! his N-CA-CB-CD
NH1   C1E   A1F   A3F     0.00    2     180.0  ! phe N-CA-CB-CD
NH1   C1E   A1Y   P1Y     0.00    2     180.0  ! tyr N-CA-CB-CD
NH1   C1E   A1W   A2W     0.00    2     180.0  ! trp N-CA-CB-CD
!C-CA-CB-CC (or C-CA-CB-CD)
C     C1E   A3K   QDK     0.00    2     180.0  ! lys
C     C1E   A3R   QDR     0.00    2     180.0  ! arg
C     C1E   A4H   P1H     0.00    2     180.0  ! his C-CA-CB-CC
C     C1E   A4H   P2H     0.00    2     180.0  ! his C-CA-CB-CD
C     C1E   A1F   A2F     0.00    2     180.0  ! phe C-CA-CB-CC
C     C1E   A1F   A3F     0.00    2     180.0  ! phe C-CA-CB-CD
C     C1E   A1Y   A2Y     0.00    2     180.0  ! tyr C-CA-CB-CC
C     C1E   A1Y   P1Y     0.00    2     180.0  ! tyr C-CA-CB-CD
C     C1E   A1W   P1W     0.00    2     180.0  ! trp C-CA-CB-CC
C     C1E   A1W   A2W     0.00    2     180.0  ! trp C-CA-CB-CD
!## for pSer                                          
C     C1E   P2S   P3S     0.00    2     180.0  ! pSer 
!## for pThr                                          
C     C1E   P2T   P3T     0.00    2     180.0  ! pThr 

!CA-CB-CC-CD (or CA-CB-CD-CC) for his, phe, tyr
C1E   A4H   P1H   P2H     0.00    2     180.0  ! his CA-CB-CC-CD
C1E   A4H   P2H   P1H     0.00    2     180.0  ! his CA-CB-CD-CC

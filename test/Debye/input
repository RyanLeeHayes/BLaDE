verbose 0

parameters file dhtest_v2fix.prm

structure file psf chain.psf
msld nblocks 0
coordinates box cubi 40 40 40 90 90 90
run setvariable debyelength 7.83  
run setvariable dielectric 60.0
run setvariable rswitch 16
run setvariable rcut 18
run setvariable invbetaewald 3.125
run setvariable orderewald 4
run setvariable gridspace 1.1
run setvariable elecmethod debye

coordinates file crd chain.crd
selection define testselection segid CHN
run setterm bond off
run setterm angle off
run setterm dihe off
run test spatial testselection 0.01

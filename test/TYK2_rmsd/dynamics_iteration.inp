!---------------------------------------------------------------------------
! One iteration of dynamics, called in a loop
!---------------------------------------------------------------------------

run energy

selection define frame and segid PROA atomname CA
selection define lig2 and segid HETA resid 2

run test spatial lig2 0.00001
run test spatial frame 0.00001
run test alchemical 0.00001

structure shake hbond
run setvariable gamma 0.1
run setvariable dt 0.002
run setvariable T {temp}

run setvariable fnmxtc dcd/{sysname}_prod{itt}.xtc
run setvariable fnmnrg dcd/{sysname}_prod{itt}.nrg
run setvariable fnmlmd res/{sysname}_prod{itt}.lmd
run setvariable fnmcpi res/{sysname}_prod{ittm1}.res
run setvariable fnmcpo res/{sysname}_prod{itt}.res
run setvariable freqxtc 50
run setvariable freqnrg 10
run setvariable freqnpt 100 
run setvariable freqlmd 10
run setvariable hrlmd yes 
run setvariable prettyxtc true ! wrap molecules over pbc 
run setvariable shaketolerance 0.000000001
run setvariable nsteps {steps_per}

! Run 1 iteration's worth of dynamics
run dynamics

